{
  "name": "@purveyors/cli",
  "version": "0.2.1",
  "description": "The official CLI for purveyors.io — coffee intelligence from your terminal",
  "type": "module",
  "bin": {
    "purvey": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/reedwhetstone/purveyors-cli.git"
  },
  "homepage": "https://purveyors.io",
  "keywords": [
    "coffee",
    "cli",
    "purveyors",
    "green-coffee",
    "roasting",
    "supabase"
  ],
  "author": "Reed Whetstone",
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@types/node": "^22.13.14",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
